# Frontend env vars (set in Netlify → Site configuration → Environment variables)
# These are embedded at build time (VITE_* prefix).

# Supabase Auth — required in production
VITE_SUPABASE_URL=https://evgmeszyxjzrrbrzznhv.supabase.co
VITE_SUPABASE_ANON_KEY=

# API host — required in production on Netlify (avoids ~26s proxy timeout).
# Use the Render host ONLY (do not include /api):
#   https://commission-backend-0d4h.onrender.com
# Leave empty for local dev (Vite proxies /api → localhost:8000).
VITE_API_BASE_URL=

# Leave Supabase vars empty for local dev without login (backend must also skip auth).
