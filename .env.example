# Copy to .env locally. Never commit .env.

# --- Database (optional locally; required on Render) ---
# Local dev: leave DATABASE_URL unset to use SQLite at data/db/commission_automation.sqlite
#
# Supabase production: use the SESSION POOLER URI (IPv4-compatible).
# In Supabase Dashboard → Project Settings → Database → Connection string:
#   - Method: URI
#   - Type: Session pooler   (NOT "Direct connection" — Render has no IPv6)
# Example shape (replace password and use aws-1 for us-west-2):
# DATABASE_URL=postgresql://postgres.evgmeszyxjzrrbrzznhv:[YOUR-PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Zoho OAuth (Self Client) ---

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=

# Optional overrides (US defaults shown)
ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_API_DOMAIN=www.zohoapis.com
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_BOOKS_BASE_URL=https://www.zohoapis.com/books/v3
